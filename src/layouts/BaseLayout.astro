---
import '../styles/global.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-serif-4/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import Header from '../components/Header.astro';
import { PRELAUNCH_MODE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Machine Learning for Engineering Applications',
  description = 'The companion portal for Machine Learning for Engineering Applications: chapter resources, Python materials, updates, and teaching support.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const shouldNoindex = PRELAUNCH_MODE || noindex;
const supabaseOrigin = (() => {
  try {
    return new URL(import.meta.env.PUBLIC_SUPABASE_URL).origin;
  } catch {
    return '';
  }
})();
const googleDriveConfigured = Boolean(import.meta.env.PUBLIC_GOOGLE_DRIVE_CLIENT_ID?.trim());
const connectSources = [
  "'self'",
  supabaseOrigin,
  supabaseOrigin.replace(/^https:/, 'wss:'),
  googleDriveConfigured ? 'https://www.googleapis.com' : '',
].filter(Boolean).join(' ');
const scriptSources = ["'self'", "'unsafe-inline'", googleDriveConfigured ? 'https://accounts.google.com' : ''].filter(Boolean).join(' ');
const frameSources = googleDriveConfigured ? "'self' https://accounts.google.com" : "'none'";
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  `connect-src ${connectSources}`,
  "font-src 'self'",
  "form-action 'self'",
  `frame-src ${frameSources}`,
  "img-src 'self' data:",
  "object-src 'none'",
  `script-src ${scriptSources}`,
  "style-src 'self' 'unsafe-inline'",
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a class="brand footer-brand" href="/" aria-label="ML4EA home">
            <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span>ML4EA</span>
          </a>
          <p>The prelaunch companion portal for <cite>Machine Learning for Engineering Applications</cite>.</p>
        </div>
        <nav class="footer-navigation" aria-label="Footer navigation">
          <a href="/book">Book</a>
          <a href="/author">Author</a>
          <a href="/learn">Learn</a>
          <a href="/resources">Resources</a>
          <a href="/contribute">Contribute</a>
          <a href="/account">Account</a>
          <a href="/privacy">Privacy</a>
          <a href="/updates/errata">Errata</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
