---
import { Archive, BookOpen, Braces, Code2, ExternalLink, GitFork, Play, Scale } from 'lucide-react';
import ApplicationExampleExplorer from '../components/ApplicationExampleExplorer';
import inventory from '../data/application-examples.json';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Application Examples | ML4EA"
  description="Explore 56 executable engineering machine learning notebooks from Machine Learning for Engineering Applications."
>
  <PageHero
    eyebrow="Application Examples"
    title="Engineering problems, worked in Python."
    description="Explore executable companion notebooks that connect machine learning methods to engineering data, models, evaluation, and decisions."
    accent="green"
  />

  <section class="ae-summary-band" aria-label="Application Example collection summary">
    <div class="container ae-summary-grid">
      <div><BookOpen aria-hidden="true" size={21} /><span><strong>{inventory.count}</strong> notebooks</span></div>
      <div><Braces aria-hidden="true" size={21} /><span><strong>Chapters 6–14</strong> methods and applications</span></div>
      <div><Code2 aria-hidden="true" size={21} /><span><strong>GitHub + Colab</strong> access</span></div>
      <div><Scale aria-hidden="true" size={21} /><span><strong>MIT</strong> licensed</span></div>
    </div>
  </section>

  <section class="content-section ae-start-section">
    <div class="container ae-start-grid">
      <div>
        <p class="eyebrow">Start here</p>
        <h2>Run one example or take the full collection.</h2>
        <p>Open any notebook in Google Colab for the quickest start. To work locally, download or clone the repository and review each notebook's setup cell and data-source notes before running it.</p>
        <div class="button-row">
          <a class="button button-primary" href="#notebooks"><Play aria-hidden="true" size={17} /> Browse notebooks</a>
          <a class="button button-secondary" href="https://github.com/ml4ea/ae-notebooks" target="_blank" rel="noreferrer"><GitFork aria-hidden="true" size={17} /> View repository</a>
          <a class="button button-secondary" href="https://github.com/ml4ea/ae-notebooks/archive/refs/heads/main.zip"><Archive aria-hidden="true" size={17} /> Download ZIP</a>
        </div>
      </div>
      <ol class="ae-start-steps">
        <li><span>01</span><p><strong>Select an AE.</strong> Search by engineering problem, method, package, or chapter.</p></li>
        <li><span>02</span><p><strong>Review its header.</strong> Check prerequisites, data sources, status, and any credential requirements.</p></li>
        <li><span>03</span><p><strong>Run from the beginning.</strong> Use a fresh runtime and interpret results in the stated engineering context.</p></li>
      </ol>
    </div>
  </section>

  <section class="content-section ae-catalog-section surface-soft" id="notebooks">
    <div class="container">
      <div class="ae-catalog-heading">
        <div>
          <p class="eyebrow">Notebook collection</p>
          <h2>Application Examples by chapter</h2>
        </div>
        <p>Notebook execution, environment details, and third-party dataset licenses are being validated progressively. Each notebook includes its current status and engineering-use notice.</p>
      </div>
      <ApplicationExampleExplorer examples={inventory.notebooks} client:load />
    </div>
  </section>

  <section class="content-section ae-contribute-band">
    <div class="container two-column-copy">
      <div>
        <p class="eyebrow">Improve the collection</p>
        <h2>Found a problem or developed a useful extension?</h2>
        <p>Reports and proposed contributions are reviewed publicly on GitHub. Include the AE number, environment, reproduction steps, sources, and engineering impact.</p>
      </div>
      <div class="ae-contribute-actions">
        <a class="button button-primary" href="/contribute">Contribution routes</a>
        <a class="text-link" href="https://github.com/ml4ea/ae-notebooks/blob/main/notebook-inventory.csv" target="_blank" rel="noreferrer">Download the notebook inventory <ExternalLink aria-hidden="true" size={16} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
