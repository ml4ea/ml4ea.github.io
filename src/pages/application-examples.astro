---
import { BookOpen, Braces, CheckCircle2, Code2, LockKeyhole } from 'lucide-react';
import ApplicationExampleExplorer from '../components/ApplicationExampleExplorer';
import inventory from '../data/application-examples.json';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Application Examples | ML4EA"
  description="Explore 56 executable engineering machine learning notebooks from Machine Learning for Engineering Applications."
>
  <PageHero
    eyebrow="Application Examples"
    title="Engineering problems, mapped to Python."
    description="Preview the catalog of companion notebooks connecting machine learning methods to engineering data, models, evaluation, and decisions."
    accent="green"
  />

  <section class="ae-summary-band" aria-label="Application Example collection summary">
    <div class="container ae-summary-grid">
      <div><BookOpen aria-hidden="true" size={21} /><span><strong>{inventory.count}</strong> notebooks</span></div>
      <div><Braces aria-hidden="true" size={21} /><span><strong>Chapters 6–14</strong> methods and applications</span></div>
      <div><Code2 aria-hidden="true" size={21} /><span><strong>Prelaunch</strong> distribution review</span></div>
      <div><CheckCircle2 aria-hidden="true" size={21} /><span><strong>Validated</strong> in Google Colab</span></div>
    </div>
  </section>

  <section class="content-section ae-start-section">
    <div class="container ae-start-grid">
      <div>
        <p class="eyebrow">Start here</p>
        <h2>Explore the collection before release.</h2>
        <p>The searchable catalog is available during prelaunch review. Three representative notebooks can be read in full after sign-in; notebook files and executable access remain controlled.</p>
        <div class="button-row">
          <a class="button button-primary" href="#notebooks"><BookOpen aria-hidden="true" size={17} /> Browse the catalog</a>
        </div>
      </div>
      <ol class="ae-start-steps">
        <li><span>01</span><p><strong>Select an AE.</strong> Search by engineering problem, method, package, or chapter.</p></li>
        <li><span>02</span><p><strong>Review its scope.</strong> Check the method, application, key packages, and validation status.</p></li>
        <li><span>03</span><p><strong>Return after review.</strong> Distribution and access instructions will be posted once publisher review is complete.</p></li>
      </ol>
    </div>
  </section>

  <section class="content-section ae-catalog-section surface-soft" id="notebooks">
    <div class="container">
      <div class="ae-catalog-heading">
        <div>
          <p class="eyebrow">Prelaunch catalog</p>
          <h2>Application Examples by chapter</h2>
        </div>
        <p>All notebooks have executed successfully and generated results in Google Colab. The files are not being distributed during prelaunch review; access details will follow after publisher guidance is confirmed.</p>
      </div>
      <ApplicationExampleExplorer examples={inventory.notebooks} client:load />
    </div>
  </section>

  <section class="content-section ae-contribute-band">
    <div class="container two-column-copy">
      <div>
        <p class="eyebrow">Contribution planning</p>
        <h2>Notebook contribution intake will open after review.</h2>
        <p>The catalog can help prospective contributors identify an AE and consider an extension. Code and notebook submissions are paused until distribution terms are confirmed.</p>
      </div>
      <div class="ae-contribute-actions">
        <a class="button button-primary" href="/contribute">Contribution routes</a>
        <span class="ae-access-note"><LockKeyhole aria-hidden="true" size={16} /> Repository access is restricted during prelaunch.</span>
      </div>
    </div>
  </section>
</BaseLayout>
