---
import PublisherExampleViewer from '../../components/PublisherExampleViewer';
import inventory from '../../data/application-examples.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Application Example | ML4EA"
  description="Read a selected Machine Learning for Engineering Applications notebook."
  noindex
>
  <section class="notebook-masthead">
    <div class="container">
      <p class="eyebrow">Protected online notebook</p>
      <h1>Application Example Notebook</h1>
      <p>Machine Learning for Engineering Applications</p>
    </div>
  </section>
  <section class="ae-single-reader">
    <div class="container manual-container">
      <PublisherExampleViewer examples={inventory.notebooks} client:load />
    </div>
  </section>
</BaseLayout>
