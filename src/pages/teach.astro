---
import { BookMarked, CalendarRange, CheckCircle2, ClipboardCheck, FileCheck2, FlaskConical, GraduationCap, Library, LockKeyhole, Settings2, UsersRound } from 'lucide-react';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Teach | ML4EA" description="Teaching pathways, pedagogical guidance, and verified instructor resources for Machine Learning for Engineering Applications.">
  <PageHero
    eyebrow="Teach"
    title="Flexible support for engineering ML courses."
    description="Shape a semester, quarter, advanced-topic, or project-based course while keeping theory, implementation, and engineering judgment in balance."
    accent="green"
  />

  <section class="content-section">
    <div class="container">
      <SectionHeading eyebrow="Course design" title="Use the book at the depth your course needs." compact />
      <div class="course-paths">
        <article><span>01</span><h3>One-semester core</h3><p>Foundations, supervised and unsupervised learning, neural networks, and system integration.</p></article>
        <article><span>02</span><h3>Quarter system</h3><p>A compressed core with selected Application Examples and a focused project.</p></article>
        <article><span>03</span><h3>Advanced topics</h3><p>Selective pathways through reinforcement, generative, physics-informed, graph, or agentic methods.</p></article>
        <article><span>04</span><h3>Project-based course</h3><p>Application Examples become seeds for framing, implementation, evaluation, and technical communication.</p></article>
      </div>
    </div>
  </section>

  <section class="content-section surface-soft">
    <div class="container teaching-principles">
      <div>
        <p class="eyebrow">Teaching emphasis</p>
        <h2 class="compact-section-heading">Keep engineering decisions visible.</h2>
      </div>
      <div class="feature-lines">
        <div><CheckCircle2 aria-hidden="true" size={20} /><p>Balance conceptual understanding, mathematical reasoning, and implementation.</p></div>
        <div><CheckCircle2 aria-hidden="true" size={20} /><p>Assess problem framing, data responsibility, evaluation, and critical interpretation.</p></div>
        <div><CheckCircle2 aria-hidden="true" size={20} /><p>Use Application Examples as walkthroughs, labs, homework, or project seeds.</p></div>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <SectionHeading eyebrow="Verified resources" title="From guidance to a working course." description="Approved instructors receive an online manual plus editable planning, activity, assessment, and setup resources." compact />
      <div class="protected-resource-list">
        <div><BookMarked aria-hidden="true" size={22} /><span><strong>Online instructor’s manual</strong>Searchable course design, pedagogical advice, chapter notes, assessment guidance, and practical resources.</span><LockKeyhole aria-label="Protected" size={18} /></div>
        <div><CalendarRange aria-hidden="true" size={22} /><span><strong>Course-planning kit</strong>Editable semester, quarter, advanced-topic, and project-based syllabus templates.</span><LockKeyhole aria-label="Protected" size={18} /></div>
        <div><FlaskConical aria-hidden="true" size={22} /><span><strong>AE teaching planner</strong>Filter all 56 notebooks and plan minimal, standard, or extended classroom use.</span><LockKeyhole aria-label="Protected" size={18} /></div>
        <div><ClipboardCheck aria-hidden="true" size={22} /><span><strong>Assessment toolkit</strong>Assignment and project templates, editable rubrics, and AI-use policy language.</span><LockKeyhole aria-label="Protected" size={18} /></div>
        <div><Library aria-hidden="true" size={22} /><span><strong>Chapter and lecture support</strong>Direct access to teaching emphasis, common challenges, activities, and AE suggestions for every chapter.</span><LockKeyhole aria-label="Protected" size={18} /></div>
        <div><Settings2 aria-hidden="true" size={22} /><span><strong>Course-startup resources</strong>Computing guidance, reproducibility expectations, and an editable pre-term checklist.</span><LockKeyhole aria-label="Protected" size={18} /></div>
        <div><UsersRound aria-hidden="true" size={22} /><span><strong>Instructor contributions</strong>A reviewed route for sharing course plans, assignments, rubrics, activities, and teaching insights.</span><LockKeyhole aria-label="Protected" size={18} /></div>
      </div>
      <div class="protected-resource-action">
        <a class="button button-primary" href="/instructor"><GraduationCap aria-hidden="true" size={18} /> Open instructor workspace</a>
        <a class="button button-secondary" href="/application-examples"><FileCheck2 aria-hidden="true" size={18} /> Browse Application Examples</a>
      </div>
    </div>
  </section>

  <section class="verification-band">
    <div class="container verification-grid">
      <div><p class="eyebrow">Instructor verification</p><h2 class="compact-section-heading">Access requires a verified teaching role.</h2></div>
      <ol>
        <li><span>1</span>Confirm ownership of an institutional email.</li>
        <li><span>2</span>Submit institution, position, and faculty-profile information.</li>
        <li><span>3</span>Receive administrative approval for protected materials.</li>
      </ol>
    </div>
  </section>
</BaseLayout>
