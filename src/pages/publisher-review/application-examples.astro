---
import BaseLayout from '../../layouts/BaseLayout.astro';

const destination = '/application-examples/view?example=svm-bearing-fault-classification';
---

<BaseLayout title="Application Examples | ML4EA" description="Continue to the regular Application Example catalog." noindex>
  <section class="content-section">
    <div class="container narrow-copy">
      <p class="eyebrow">Application Examples</p>
      <h1>The complete collection has moved.</h1>
      <p>All signed-in notebook views are now opened from the regular Application Example catalog.</p>
      <a class="button button-primary" href={destination}>Continue to the examples</a>
    </div>
  </section>
  <script is:inline define:vars={{ destination }}>
    window.location.replace(destination);
  </script>
</BaseLayout>
