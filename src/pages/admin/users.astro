  <PageHero eyebrow="Administration" title="Portal users." description="Review signed-in accounts, instructor status, portal roles, and recent access activity." accent="orange" />
  <section class="content-section">
    <div class="container account-container">
      <AdminUsers client:load />
    </div>
  </section>
</BaseLayout>
