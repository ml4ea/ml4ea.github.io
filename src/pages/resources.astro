---
import CatalogExplorer from '../components/CatalogExplorer';
import PageHero from '../components/PageHero.astro';
import { resourceItems } from '../data/catalog';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resources | ML4EA" description="Search ML4EA chapter guides and Application Examples by topic, type, and chapter.">
  <PageHero
    eyebrow="Resources"
    title="Find the right chapter or engineering example."
    description="Search chapter guides and book topics, or move directly into the published Application Example notebook collection."
    accent="cyan"
  />
  <section class="content-section catalog-section">
    <div class="container">
      <div class="resource-callout">
        <div><p class="eyebrow">Executable notebooks</p><h2>Application Examples are now available.</h2></div>
        <a class="button button-primary" href="/application-examples">Explore all AEs</a>
      </div>
      <CatalogExplorer items={resourceItems} initialQueryFromUrl={true} client:load />
    </div>
  </section>
</BaseLayout>
