---
import { ArrowRight, FileCheck2, Megaphone, MessageSquareText, Scale, ShieldCheck } from 'lucide-react';
import DiscussionBoard from '../components/DiscussionBoard';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Community | ML4EA" description="The public participation model for ML4EA discussions, engineering insights, errata, and contributed materials.">
  <PageHero
    eyebrow="Community"
    title="A place to compare engineering reasoning."
    description="The community connects readers, students, practicing engineers, and instructors around chapters, Application Examples, and responsible use."
    accent="magenta"
  />

  <section class="community-purpose-band">
    <div class="container community-purpose-grid">
      <div><MessageSquareText aria-hidden="true" size={24} /><p class="eyebrow">Discuss</p><h2 class="compact-section-heading">Have a conversation.</h2><p>Ask questions, compare reasoning, respond to others, and share experience. Public discussions can be read by everyone; posting requires a signed-in account.</p></div>
      <a href="/contribute"><FileCheck2 aria-hidden="true" size={24} /><p class="eyebrow">Contribute</p><h2 class="compact-section-heading">Propose a lasting addition.</h2><p>Use the contribution workflow for corrections, notebook changes, new examples, and reusable teaching materials.</p><span>Go to Contributions <ArrowRight aria-hidden="true" size={17} /></span></a>
    </div>
  </section>

  <section class="community-launch-announcement" aria-labelledby="community-launch-title">
    <div class="container community-launch-inner">
      <Megaphone aria-hidden="true" size={25} />
      <div>
        <p class="eyebrow">Announcement · July 31, 2026</p>
        <h2 id="community-launch-title">The ML4EA companion portal is now open.</h2>
        <p>After careful design and development, followed by diligent verification of its content and key workflows, we are pleased to launch the companion portal for <em>Machine Learning for Engineering Applications</em>. Explore the book resources, share questions and insights, and help this community grow through thoughtful discussion and contributions.</p>
      </div>
      <div class="community-launch-actions">
        <a class="button button-primary" href="#community-discussions">Join the discussion</a>
        <a class="text-link" href="/updates#portal-launched">Read the launch note <ArrowRight aria-hidden="true" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="content-section community-board-section" id="community-discussions">
    <div class="container community-board-container">
      <DiscussionBoard client:load />
    </div>
  </section>

  <section class="content-section surface-soft">
    <div class="container community-principles">
      <div><p class="eyebrow">Participation principles</p><h2 class="compact-section-heading">Useful, attributable, and respectful.</h2></div>
      <div>
        <p><ShieldCheck aria-hidden="true" size={20} /><span><strong>Evidence over assertion.</strong> Explain assumptions, data sources, and validation choices.</span></p>
        <p><Scale aria-hidden="true" size={20} /><span><strong>Engineering context matters.</strong> Include constraints, consequences, and limitations.</span></p>
        <p><MessageSquareText aria-hidden="true" size={20} /><span><strong>Critique ideas constructively.</strong> Keep discussions focused on helping participants learn and improve.</span></p>
      </div>
    </div>
  </section>

</BaseLayout>
