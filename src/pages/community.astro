---
import { ArrowRight, FileCheck2, MessageSquareText, Scale, ShieldCheck } from 'lucide-react';
import DiscussionBoard from '../components/DiscussionBoard';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Community | ML4EA" description="The public participation model for ML4EA discussions, engineering insights, errata, and contributed materials.">
  <PageHero
    eyebrow="Community"
    title="A place to compare engineering reasoning."
    description="The community connects readers, students, practicing engineers, and instructors around chapters, Application Examples, and responsible use."
    accent="magenta"
  />

  <section class="community-purpose-band">
    <div class="container community-purpose-grid">
      <div><MessageSquareText aria-hidden="true" size={24} /><p class="eyebrow">Discuss</p><h2>Have a conversation.</h2><p>Ask questions, compare reasoning, respond to others, and share experience. Public discussions can be read by everyone; posting requires a signed-in account.</p></div>
      <a href="/contribute"><FileCheck2 aria-hidden="true" size={24} /><p class="eyebrow">Contribute</p><h2>Propose a lasting addition.</h2><p>Use the contribution workflow for corrections, notebook changes, new examples, and reusable teaching materials.</p><span>Go to Contributions <ArrowRight aria-hidden="true" size={17} /></span></a>
    </div>
  </section>

  <section class="content-section community-board-section">
    <div class="container community-board-container">
      <DiscussionBoard client:load />
    </div>
  </section>

  <section class="content-section surface-soft">
    <div class="container community-principles">
      <div><p class="eyebrow">Participation principles</p><h2>Useful, attributable, and respectful.</h2></div>
      <div>
        <p><ShieldCheck aria-hidden="true" size={20} /><span><strong>Evidence over assertion.</strong> Explain assumptions, data sources, and validation choices.</span></p>
        <p><Scale aria-hidden="true" size={20} /><span><strong>Engineering context matters.</strong> Include constraints, consequences, and limitations.</span></p>
        <p><MessageSquareText aria-hidden="true" size={20} /><span><strong>Critique ideas constructively.</strong> Keep discussions focused on helping participants learn and improve.</span></p>
      </div>
    </div>
  </section>

</BaseLayout>
