---
import { ArrowRight, CheckCircle2, Clock3, FileText } from 'lucide-react';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Updates | ML4EA" description="Portal announcements, new materials, software notes, and verified errata for Machine Learning for Engineering Applications.">
  <PageHero
    eyebrow="Updates"
    title="A living record beyond the printed page."
    description="Follow verified corrections, new learning materials, revised code, and companion-portal announcements."
    accent="orange"
  />

  <section class="content-section">
    <div class="container updates-layout">
      <div>
        <SectionHeading eyebrow="Latest" title="Portal updates" />
        <ol class="update-feed">
          <li id="ae-access-opened">
            <div class="update-date"><time datetime="2026-07-29">July 29, 2026</time><span>Application Examples</span></div>
            <div><h2>Publisher permission received for companion notebooks</h2><p>All 56 validated Application Examples are now available to verified portal accounts. Signed-in users can read executed notebooks online and, after accepting the use restrictions, load a personal copy into Google Colab or download the `.ipynb` file.</p></div>
          </li>
          <li id="prelaunch-review">
            <div class="update-date"><time datetime="2026-07-23">July 23, 2026</time><span>Prelaunch</span></div>
            <div><h2>Portal entered prelaunch review</h2><p>The portal now carries a visible preview notice and site-wide no-index instruction. The searchable Application Example catalog remains available, while notebook files, repository access, and code contribution routes are held pending publisher review.</p></div>
          </li>
          <li id="preview-prepared">
            <div class="update-date"><time datetime="2026-07-21">July 21, 2026</time><span>Portal</span></div>
            <div><h2>Companion portal preview prepared</h2><p>The book overview, 15 chapter hubs, searchable Application Example catalog, protected teaching workspace, community framework, updates, and errata register are ready for review.</p></div>
          </li>
          <li>
            <div class="update-date"><time datetime="2026-07-20">July 20, 2026</time><span>Foundation</span></div>
            <div><h2>ML4EA design foundation established</h2><p>The Engineering Field Guide visual system and automated GitHub Pages deployment were established as the portal foundation.</p></div>
          </li>
        </ol>
      </div>
      <aside class="updates-index" aria-label="Update categories">
        <h2>Track changes</h2>
        <a href="/updates/errata"><FileText aria-hidden="true" size={19} /><span><strong>Errata</strong>Verified corrections by chapter</span><ArrowRight aria-hidden="true" size={17} /></a>
        <div><CheckCircle2 aria-hidden="true" size={19} /><span><strong>New materials</strong>Validated scripts and resources</span></div>
        <div><Clock3 aria-hidden="true" size={19} /><span><strong>Software notes</strong>Compatibility and environment changes</span></div>
      </aside>
    </div>
  </section>
</BaseLayout>
