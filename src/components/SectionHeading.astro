---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  compact?: boolean;
  id?: string;
}

const { eyebrow, title, description, compact = false, id } = Astro.props;
---

<header class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class:list={{ 'compact-section-heading': compact }}>{title}</h2>
  {description && <p>{description}</p>}
</header>
