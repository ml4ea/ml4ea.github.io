---
import { heroImages } from '../data/heroImages';

interface Props {
  mode?: 'image' | 'background';
  class?: string;
}

const { mode = 'image', class: className } = Astro.props;
const initial = heroImages[0];
const imageData = JSON.stringify(heroImages);
---

{mode === 'background' ? (
  <div
    class={className}
    data-random-hero-background
    data-hero-images={imageData}
    role="img"
    aria-label={initial.alt}
    style={`background-image: url('${initial.src}')`}
  ></div>
) : (
  <img
    class={className}
    data-random-hero-image
    data-hero-images={imageData}
    src={initial.src}
    alt={initial.alt}
    loading="eager"
    decoding="async"
  />
)}

<script is:inline>
  document.querySelectorAll('[data-hero-images]').forEach((element) => {
    if (!(element instanceof HTMLElement)) return;
    const images = JSON.parse(element.dataset.heroImages || '[]');
    if (!images.length) return;

    const values = new Uint32Array(1);
    crypto.getRandomValues(values);
    const selected = images[values[0] % images.length];

    element.setAttribute('aria-label', selected.alt);
    if (element instanceof HTMLImageElement) {
      element.src = selected.src;
      element.alt = selected.alt;
    } else {
      element.style.backgroundImage = `url('${selected.src}')`;
    }
  });
</script>
